# Copy to .env.agent (gitignored) on each mesh node -- see
# docker-compose.agent.yml.

RVTX_CONTROLPLANE_URL=ws://controlplane-host:8080/ws/agent
RVTX_NODE_NAME=this-node-name

# Optional -- leave unset to let the control plane auto-detect the
# endpoint from the connection's source IP + RVTX_LISTEN_PORT. Only
# needed for NAT cases auto-detection can't handle.
RVTX_ENDPOINT_OVERRIDE=
RVTX_INTERFACE=rvtx0
RVTX_KEY_PATH=/etc/rvtx/private.key
RVTX_LISTEN_PORT=51820
RVTX_HEARTBEAT_SECONDS=15
