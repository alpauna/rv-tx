# Copy to .env (gitignored) and fill in real values before running
# `docker compose up` -- see docker-compose.yml.

RVTX_POSTGRES_DSN=postgres://user:password@host:5432/rvtx
RVTX_MESH_CIDR=100.100.0.0/24
RVTX_LISTEN_ADDR=:8080

# bcrypt hash + a random secret -- see README.md's "Accounts, roles,
# and email" section for how these bootstrap the first admin account.
RVTX_DASHBOARD_PASSWORD_HASH=
RVTX_SESSION_SECRET=
RVTX_BOOTSTRAP_ADMIN_EMAIL=

RVTX_DASHBOARD_BASE_URL=https://your-domain.example

# SMTP relay for invite/password-reset emails.
RVTX_SMTP_SERVER=
RVTX_SMTP_PORT=587
RVTX_SMTP_USER=
RVTX_SMTP_PASSWORD=
RVTX_SMTP_FROM=
