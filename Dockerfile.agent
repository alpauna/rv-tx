# The agent shells out to real `wg`/`ip` binaries rather than using a
# pure-Go WireGuard stack (deliberate project choice, see README) --
# both tools have to actually be present in the runtime image, not
# just the build stage.

FROM golang:1.26-bookworm AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/rvtx-agent ./cmd/agent

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        wireguard-tools \
        iproute2 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=go-build /out/rvtx-agent /usr/local/bin/rvtx-agent
ENTRYPOINT ["/usr/local/bin/rvtx-agent"]
